# Copy to .env and fill in. Never commit .env.

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# --- Auth -------------------------------------------------------------------
# Required outside the local profile. Generate with: openssl rand -base64 48
# JWT_SECRET=

# --- Database (defaults match infra/docker-compose.yml) ---------------------
DB_URL=jdbc:postgresql://localhost:5433/securepay
DB_USERNAME=securepay
DB_PASSWORD=securepay_local_dev

# --- Payments ---------------------------------------------------------------
# sandbox (default, in-memory) or stripe (TEST mode only; live keys are refused)
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AWS (read-only) --------------------------------------------------------
# Credentials come from your AWS profile / instance role, never from this file.
AWS_ENABLED=false
AWS_REGION=ap-south-1
